{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-llvm-mingw-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_FIND_LIBRARY_SUFFIXES": ".a",
        "WHISPER_BUILD_TESTS": "OFF",
        "WHISPER_BUILD_EXAMPLES": "OFF",
        "GGML_STATIC": "ON",
        "GGML_NATIVE": "ON",
        "GGML_LTO": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (Smallest)",
      "description": "Cross-compile for Windows x64 with maximum size optimization",
      "inherits": "windows-llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "LLVM_MINGW_ARCH": "x86_64"
      }
    },
    {
      "name": "windows-x64-native",
      "displayName": "Windows x64 Native Build",
      "description": "Native Windows build with LLVM-MinGW (use this on Windows)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_FIND_LIBRARY_SUFFIXES": ".a",
        "WHISPER_BUILD_TESTS": "OFF",
        "WHISPER_BUILD_EXAMPLES": "OFF",
        "GGML_STATIC": "ON",
        "GGML_NATIVE": "ON",
        "GGML_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "MinSizeRel",
      "verbose": false
    },
    {
      "name": "windows-x64-native",
      "configurePreset": "windows-x64-native",
      "configuration": "MinSizeRel",
      "verbose": false
    }
  ]
}

